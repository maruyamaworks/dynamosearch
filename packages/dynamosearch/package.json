{
  "name": "dynamosearch",
  "version": "1.0.0",
  "description": "Elasticsearch-inspired search, built for DynamoDB",
  "keywords": ["dynamodb", "search", "serverless", "elasticsearch", "opensearch"],
  "homepage": "https://maruyamaworks.github.io/dynamosearch/",
  "bugs": "https://github.com/maruyamaworks/dynamosearch/issues",
  "license": "MIT",
  "author": "Kenichi Maruyama <11133876+maruyamaworks@users.noreply.github.com>",
  "main": "dist/index.js",
  "type": "module",
  "exports": {
    ".": "./dist/index.js",
    "./analyzers/*": "./dist/analyzers/*.js",
    "./char_filters/*": "./dist/char_filters/*.js",
    "./tokenizers/*": "./dist/tokenizers/*.js",
    "./filters/*": "./dist/filters/*.js"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/maruyamaworks/dynamosearch.git",
    "directory": "packages/dynamosearch"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "generate:parser": "pnpm dlx peggy -o src/query_parser/parser.js --format es --dts --return-types '{\"start\":\"import(\\\"../index.js\\\").Query\"}' src/query_parser/SimpleQueryString.peg.js"
  },
  "devDependencies": {
    "@aws-sdk/client-dynamodb": "^3.929.0",
    "@types/aws-lambda": "^8.10.158"
  },
  "peerDependencies": {
    "@aws-sdk/client-dynamodb": "^3.929.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
